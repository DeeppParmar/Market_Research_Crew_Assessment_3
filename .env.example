# Google Gemini API Configuration (Default supported provider)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-3.8-flash

# OpenAI API Configuration (Alternative supported provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Search Tool API Configuration (Tavily or Serper)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Execution Mode: set to false for live LLM, or true for offline test evaluation
MOCK_EXECUTION=false
