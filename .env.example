# OpenAI API Configuration (Required for default CrewAI manager and agents)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Search Tool API Configuration (Provide at least one for live web scraping)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Optional: Execution Mode (real or mock for deterministic offline evaluation)
MOCK_EXECUTION=false
